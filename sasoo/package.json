{
  "name": "sasoo",
  "version": "1.3.0",
  "description": "Sasoo - AI-powered academic paper analysis tool",
  "private": true,
  "main": "dist-electron/main.js",
  "author": "dosigner",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently --kill-others \"pnpm dev:frontend\" \"pnpm dev:electron\"",
    "dev:frontend": "cd frontend && pnpm dev",
    "dev:electron": "tsc -p electron/tsconfig.json && electron . --disable-gpu",
    "dev:electron:watch": "concurrently \"tsc -p electron/tsconfig.json --watch\" \"electron .\"",
    "build:frontend": "cd frontend && pnpm build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:backend": "node scripts/build-backend.js",
    "build": "pnpm build:frontend && pnpm build:electron && electron-builder",
    "clean:win": "node scripts/prepare-win-build.js",
    "build:win": "pnpm clean:win && pnpm build:backend && pnpm build:frontend && pnpm build:electron && electron-builder --win --publish never",
    "build:win:release": "pnpm build:win && pnpm verify:win-artifact",
    "clean:mac": "node scripts/prepare-mac-build.js",
    "build:mac": "pnpm clean:mac && pnpm build:backend && pnpm build:frontend && pnpm build:electron && electron-builder --mac --publish never",
    "build:mac:release": "pnpm build:mac && pnpm verify:mac-artifact",
    "build:linux": "pnpm build:backend && pnpm build:frontend && pnpm build:electron && electron-builder --linux",
    "verify:mac-artifact": "node scripts/verify-mac-artifacts.js",
    "verify:win-artifact": "node scripts/verify-win-artifacts.js",
    "test:unit": "vitest run",
    "start": "electron .",
    "clean": "rm -rf dist dist-electron frontend/dist backend/dist backend/build",
    "postinstall": "cd frontend && pnpm install --frozen-lockfile"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "electron": "^43.8.7",
    "electron-builder": "^26.18.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.dosigner.sasoo",
    "productName": "Sasoo",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "!backend",
      "!electron",
      "!frontend/src",
      "!frontend/node_modules",
      "!frontend/package.json",
      "!scripts",
      "!**/*.ts",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "backend/dist/sasoo-backend",
        "to": "backend/sasoo-backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "zip",
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "dosigner",
        "repo": "sasoo"
      }
    ]
  },
  "pnpm": {
    "overrides": {
      "vite@>=8.0.0 <8.1.6": "8.1.6",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "minimatch@>=7.0.0 <11.0.1": "11.0.1"
    }
  }
}
