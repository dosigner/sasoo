{
  "text": "<style>\n  .otcalc {\n    --ink: #17202a;\n    --muted: #455468;\n    --line: #c6d0dc;\n    --panel: #f4f7fa;\n    --blue: #0759a5;\n    --orange: #a84300;\n    color: var(--ink);\n    font: 1rem/1.5 system-ui, sans-serif;\n    max-width: 900px;\n    margin: 1rem auto;\n    padding: 1rem;\n  }\n  .otcalc * { box-sizing: border-box; }\n  .otcalc h2, .otcalc h3 { line-height: 1.25; }\n  .otcalc h2 { margin: 0 0 .35rem; font-size: 1.55rem; }\n  .otcalc h3 { margin: 1rem 0 .4rem; font-size: 1.1rem; }\n  .otcalc p { margin: .35rem 0 .7rem; }\n  .otcalc .muted { color: var(--muted); }\n  .otcalc .controls {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: .65rem;\n    margin: .8rem 0;\n  }\n  .otcalc label {\n    display: block;\n    min-width: 0;\n    font-weight: 650;\n  }\n  .otcalc input {\n    display: block;\n    width: 100%;\n    min-height: 2.65rem;\n    margin-top: .22rem;\n    padding: .45rem .55rem;\n    border: 1px solid #738399;\n    border-radius: .35rem;\n    background: #fff;\n    color: var(--ink);\n    font: inherit;\n  }\n  .otcalc input:focus-visible, .otcalc button:focus-visible, .otcalc summary:focus-visible {\n    outline: 3px solid #1676c5;\n    outline-offset: 2px;\n  }\n  .otcalc .actions { display: flex; align-items: center; gap: .8rem; flex-wrap: wrap; }\n  .otcalc button {\n    min-height: 2.6rem;\n    padding: .45rem .8rem;\n    border: 1px solid #284965;\n    border-radius: .35rem;\n    background: #fff;\n    color: var(--ink);\n    font: inherit;\n    font-weight: 650;\n    cursor: pointer;\n  }\n  .otcalc .error {\n    margin: .65rem 0;\n    padding: .55rem .7rem;\n    border-left: 4px solid #a31d24;\n    background: #fff0f0;\n    color: #71151a;\n    font-weight: 650;\n  }\n  .otcalc .results {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: .6rem;\n    margin-top: .75rem;\n  }\n  .otcalc .result {\n    min-width: 0;\n    padding: .65rem .75rem;\n    border: 1px solid var(--line);\n    border-radius: .4rem;\n    background: var(--panel);\n  }\n  .otcalc .result strong { display: block; margin-bottom: .2rem; }\n  .otcalc output {\n    display: block;\n    overflow-wrap: anywhere;\n    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n    font-size: .97rem;\n  }\n  .otcalc .graph-wrap {\n    margin-top: .7rem;\n    padding: .5rem;\n    border: 1px solid var(--line);\n    border-radius: .4rem;\n    background: #fff;\n  }\n  .otcalc svg { display: block; width: 100%; height: auto; }\n  .otcalc .legend { display: flex; flex-wrap: wrap; gap: .7rem 1rem; font-size: .9rem; }\n  .otcalc .key { display: inline-flex; align-items: center; gap: .35rem; }\n  .otcalc .swatch { width: 1.2rem; height: .2rem; background: var(--blue); }\n  .otcalc .swatch.second { background: var(--orange); }\n  .otcalc details {\n    margin-top: .8rem;\n    padding: .65rem .75rem;\n    border: 1px solid var(--line);\n    border-radius: .4rem;\n  }\n  .otcalc summary { cursor: pointer; font-weight: 700; }\n  .otcalc code { overflow-wrap: anywhere; }\n  .otcalc .math { padding: .45rem .6rem; background: var(--panel); border-radius: .3rem; }\n  @media (max-width: 650px) {\n    .otcalc { padding: .7rem; }\n    .otcalc .controls { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .otcalc .results { grid-template-columns: 1fr; }\n  }\n  @media (max-width: 360px) {\n    .otcalc .controls { grid-template-columns: 1fr; }\n  }\n</style>\n\n<section class=\"otcalc\" id=\"ot-field-calculator\" aria-labelledby=\"ot-title\">\n  <h2 id=\"ot-title\">OT field calculator</h2>\n  <p class=\"muted\">입력 벡터와 시간에 따라 conditional flow map 및 그 위치에서의 vector field를 계산합니다.</p>\n\n  <div class=\"controls\" aria-label=\"독립 변수 입력\">\n    <label for=\"ot-x0\">독립 변수 <code>x0</code> 벡터\n      <input id=\"ot-x0\" type=\"text\" inputmode=\"decimal\" value=\"1, -2\" required aria-describedby=\"ot-input-help\">\n    </label>\n    <label for=\"ot-x1\">독립 변수 <code>x1</code> 벡터\n      <input id=\"ot-x1\" type=\"text\" inputmode=\"decimal\" value=\"3, 4\" required aria-describedby=\"ot-input-help\">\n    </label>\n    <label for=\"ot-t\">독립 변수 <code>t</code>\n      <input id=\"ot-t\" type=\"number\" min=\"0\" max=\"1\" step=\"any\" value=\"0.5\" required>\n    </label>\n    <label for=\"ot-sigma\">독립 변수 <code>sigma_min</code>\n      <input id=\"ot-sigma\" type=\"number\" min=\"0\" step=\"any\" value=\"0.1\" required>\n    </label>\n  </div>\n  <p id=\"ot-input-help\" class=\"muted\">벡터 성분은 쉼표로 구분합니다. 모든 숫자 입력은 필수입니다. 허용 범위: <code>t ∈ [0,1]</code>, <code>sigma_min &gt; 0</code>.</p>\n\n  <div class=\"actions\">\n    <button type=\"button\" id=\"ot-reset\">검산 예로 되돌리기</button>\n    <span class=\"muted\">화면의 초기 입력은 아래 검산 예이며, 논문의 학습 설정값을 뜻하지 않습니다.</span>\n  </div>\n\n  <p class=\"error\" id=\"ot-error\" role=\"alert\" hidden></p>\n\n  <div class=\"results\" aria-label=\"현재 계산 결과\">\n    <div class=\"result\"><strong>파생 변수 <code>a</code></strong><output id=\"ot-a\" aria-label=\"a 계산값\"></output></div>\n    <div class=\"result\"><strong>Flow map 위치 <code>psi_t(x0)</code></strong><output id=\"ot-psi\" aria-label=\"psi 계산값\"></output></div>\n    <div class=\"result\"><strong>Fixed-position field: <code>u_t(x0|x1)</code>, 위치 <code>x=x0</code></strong><output id=\"ot-fixed\" aria-label=\"고정 위치 vector field 계산값\"></output></div>\n    <div class=\"result\"><strong>Moving-position field: <code>u_t(psi_t(x0)|x1)</code></strong><output id=\"ot-moving\" aria-label=\"flow map 위 vector field 계산값\"></output></div>\n  </div>\n\n  <div class=\"graph-wrap\" id=\"ot-graph-wrap\">\n    <strong>Flow map 궤적</strong>\n    <p class=\"muted\">가로축은 <code>t</code>, 세로축은 vector 성분입니다. 최대 두 성분을 표시하며, 점은 현재 입력의 위치입니다.</p>\n    <div class=\"legend\" aria-hidden=\"true\">\n      <span class=\"key\"><span class=\"swatch\"></span>성분 1</span>\n      <span class=\"key\"><span class=\"swatch second\"></span>성분 2</span>\n    </div>\n    <svg id=\"ot-graph\" viewBox=\"0 0 640 270\" role=\"img\" aria-label=\"flow map 궤적 그래프\"></svg>\n  </div>\n\n  <details>\n    <summary>가정, 변수 관계, 원문 근거 및 검산 예</summary>\n    <h3>변수와 계산 위치</h3>\n    <ul>\n      <li><strong>독립 변수:</strong> 같은 차원의 비어 있지 않은 <code>x0</code>, <code>x1</code>, <code>t</code>, <code>sigma_min</code>.</li>\n      <li><strong>파생 변수:</strong> <code>a = 1 − (1 − sigma_min)t</code>, 항상 <code>t ∈ [0,1]</code> 및 <code>sigma_min &gt; 0</code>에서 양수입니다.</li>\n      <li><strong>Flow map:</strong> <code>psi_t(x0) = a x0 + t x1</code>. 이는 좌표/샘플을 변환하는 map이며 확률밀도 자체가 아닙니다.</li>\n      <li><strong>Fixed-position field:</strong> Equation 21에 고정 좌표 <code>x=x0</code>를 대입한 값, <code>(x1 − (1 − sigma_min)x0)/a</code>.</li>\n      <li><strong>Moving-position field:</strong> 같은 field를 flow map 위의 좌표 <code>x=psi_t(x0)</code>에서 평가한 값, <code>x1 − (1 − sigma_min)x0</code>. 이는 Equation 22의 시간 미분이자 Equation 23의 회귀 target입니다.</li>\n    </ul>\n    <p class=\"math\"><code>mu_t(x1)=t x1</code>, <code>sigma_t(x1)=1−(1−sigma_min)t</code> (Equation 20) → <code>psi_t(x0)=sigma_t x0+mu_t</code> (Equation 22).</p>\n\n    <h3>범위 및 표시 정책</h3>\n    <p>숫자 입력은 모두 필수이며 빈 문자열이나 공백을 숫자로 바꾸지 않습니다. 벡터의 빈 성분, 유한하지 않은 숫자, 차원 불일치, 범위 밖의 <code>t</code>, 0 이하의 <code>sigma_min</code>은 거부합니다. 오류가 있으면 계산 결과를 모두 지우고 그래프를 숨깁니다. <code>sigma_min=0.1</code>은 설명용 검산 입력일 뿐, 논문에서 보고한 학습값이 아닙니다.</p>\n    <p>특수 조건 <code>t=0, x0=0</code>에서는 <code>a=1</code>, <code>psi_t(x0)=0</code>, 두 field가 모두 <code>x1</code>입니다. 이 조건에서 map은 <code>x1</code>과 <code>sigma_min</code>에 무관하고, field는 <code>sigma_min</code>에 무관합니다. field 값 자체는 <code>x1</code>에 따라 변합니다.</p>\n\n    <h3>원문 근거 및 검산 예</h3>\n    <p>원문 Equations 10, 20, 21, 22, 23에 근거합니다. Equation 10은 Gaussian conditional probability path를 정의하고, Equations 20–23은 여기서 사용한 OT path, vector field, flow map, CFM target을 제시합니다. 이 도구는 해당 식의 설명용 계산이며 논문 실험의 재현이나 성능 추정이 아닙니다.</p>\n    <p><strong>검산 예:</strong> <code>x0=[1,−2]</code>, <code>x1=[3,4]</code>, <code>t=0.5</code>, <code>sigma_min=0.1</code>이면 <code>a=0.55</code>, <code>psi_t(x0)=[2.05,0.9]</code>, fixed-position field <code>=[3.818181818,10.545454545]</code>, moving-position field <code>=[2.1,5.8]</code>입니다. 초기 입력으로 JavaScript <code>assert</code> 검산도 수행합니다.</p>\n    <p><output id=\"ot-assert-status\" aria-label=\"검산 예 확인 상태\"></output></p>\n  </details>\n</section>\n\n<script>\n(() => {\n  \"use strict\";\n\n  const root = document.getElementById(\"ot-field-calculator\");\n  const x0Input = document.getElementById(\"ot-x0\");\n  const x1Input = document.getElementById(\"ot-x1\");\n  const tInput = document.getElementById(\"ot-t\");\n  const sigmaInput = document.getElementById(\"ot-sigma\");\n  const errorBox = document.getElementById(\"ot-error\");\n  const graphWrap = document.getElementById(\"ot-graph-wrap\");\n  const svg = document.getElementById(\"ot-graph\");\n  const outputs = {\n    a: document.getElementById(\"ot-a\"),\n    psi: document.getElementById(\"ot-psi\"),\n    fixed: document.getElementById(\"ot-fixed\"),\n    moving: document.getElementById(\"ot-moving\")\n  };\n\n  // 이 특수 조건에서 map/field가 입력에 대해 불변이 되는 수학적 이유를 표시한다.\n  x1Input.dataset.checkConstant = \"t=0, x0=0이면 psi=0으로 x1에 무관하지만 두 field는 x1 자체이므로 x1에 따라 변합니다.\";\n  sigmaInput.dataset.checkConstant = \"t=0이면 a=1이며, x0=0이면 psi=0 및 두 field=x1이므로 이 출력들은 sigma_min에 무관합니다.\";\n\n  function parseScalar(input, name) {\n    const raw = input.value.trim();\n    if (raw === \"\") throw new Error(name + \"은(는) 필수 입력입니다.\");\n    if (!/^[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?$/.test(raw)) {\n      throw new Error(name + \"에는 유효한 숫자를 입력하세요.\");\n    }\n    const value = Number(raw);\n    if (!Number.isFinite(value)) throw new Error(name + \"은(는) 유한한 숫자여야 합니다.\");\n    return value;\n  }\n\n  function parseVector(input, name) {\n    const raw = input.value.trim();\n    if (raw === \"\") throw new Error(name + \" 벡터는 필수 입력입니다.\");\n    const parts = raw.split(\",\");\n    const values = parts.map((part, index) => {\n      const token = part.trim();\n      if (token === \"\") throw new Error(name + \" 벡터의 \" + (index + 1) + \"번째 성분이 비어 있습니다.\");\n      if (!/^[+-]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?$/.test(token)) {\n        throw new Error(name + \" 벡터의 \" + (index + 1) + \"번째 성분이 유효한 숫자가 아닙니다.\");\n      }\n      const value = Number(token);\n      if (!Number.isFinite(value)) throw new Error(name + \" 벡터에는 유한한 숫자만 입력할 수 있습니다.\");\n      return value;\n    });\n    return values;\n  }\n\n  function formatNumber(value) {\n    if (!Number.isFinite(value)) throw new Error(\"계산 결과가 유한한 숫자가 아닙니다. 입력을 확인하세요.\");\n    return value.toFixed(9).replace(/\\.?0+$/, \"\") || \"0\";\n  }\n\n  function formatVector(vector) {\n    return \"[\" + vector.map(formatNumber).join(\", \") + \"]\";\n  }\n\n  function clearResults(message) {\n    Object.values(outputs).forEach(output => { output.textContent = \"\"; });\n    svg.replaceChildren();\n    graphWrap.hidden = true;\n    errorBox.textContent = message || \"\";\n    errorBox.hidden = !message;\n  }\n\n  function makeSvg(tag, attrs, text) {\n    const node = document.createElementNS(\"http://www.w3.org/2000/svg\", tag);\n    Object.entries(attrs || {}).forEach(([key, value]) => node.setAttribute(key, String(value)));\n    if (text !== undefined) node.textContent = text;\n    return node;\n  }\n\n  function drawGraph(x0, x1, sigma, currentT, currentPsi) {\n    svg.replaceChildren();\n    svg.setAttribute(\"aria-label\", \"Flow map 궤적: 시간에 따른 첫 \" + Math.min(2, x0.length) + \"개 성분과 현재 위치\");\n\n    const W = 640, H = 270;\n    const left = 58, right = 18, top = 20, bottom = 42;\n    const plotW = W - left - right, plotH = H - top - bottom;\n    const count = Math.min(2, x0.length);\n    const series = [];\n    for (let j = 0; j < count; j++) {\n      const values = [];\n      for (let i = 0; i <= 40; i++) {\n        const time = i / 40;\n        const a = 1 - (1 - sigma) * time;\n        values.push(a * x0[j] + time * x1[j]);\n      }\n      series.push(values);\n    }\n    let minY = Math.min(...series.flat());\n    let maxY = Math.max(...series.flat());\n    if (minY === maxY) { minY -= 1; maxY += 1; }\n    const pad = (maxY - minY) * 0.12;\n    minY -= pad; maxY += pad;\n    const px = time => left + time * plotW;\n    const py = value => top + (maxY - value) / (maxY - minY) * plotH;\n\n    for (let i = 0; i <= 4; i++) {\n      const y = top + (plotH * i / 4);\n      const val = maxY - (maxY - minY) * i / 4;\n      svg.appendChild(makeSvg(\"line\", {x1:left, y1:y, x2:W-right, y2:y, stroke:\"#d8e0e8\", \"stroke-width\":1}));\n      svg.appendChild(makeSvg(\"text\", {x:left-8, y:y+4, \"text-anchor\":\"end\", fill:\"#344256\", \"font-size\":12}, formatNumber(val)));\n    }\n    svg.appendChild(makeSvg(\"line\", {x1:left, y1:top+plotH, x2:W-right, y2:top+plotH, stroke:\"#344256\", \"stroke-width\":1.5}));\n    svg.appendChild(makeSvg(\"line\", {x1:left, y1:top, x2:left, y2:top+plotH, stroke:\"#344256\", \"stroke-width\":1.5}));\n    svg.appendChild(makeSvg(\"text\", {x:left, y:H-12, \"text-anchor\":\"middle\", fill:\"#17202a\", \"font-size\":13}, \"0\"));\n    svg.appendChild(makeSvg(\"text\", {x:W-right, y:H-12, \"text-anchor\":\"middle\", fill:\"#17202a\", \"font-size\":13}, \"1\"));\n    svg.appendChild(makeSvg(\"text\", {x:left+plotW/2, y:H-12, \"text-anchor\":\"middle\", fill:\"#17202a\", \"font-size\":13}, \"t\"));\n\n    const colors = [\"#0759a5\", \"#a84300\"];\n    series.forEach((values, j) => {\n      const points = values.map((value, i) => px(i / 40) + \",\" + py(value)).join(\" \");\n      svg.appendChild(makeSvg(\"polyline\", {\n        points, fill:\"none\", stroke:colors[j], \"stroke-width\":3,\n        \"stroke-linecap\":\"round\", \"stroke-linejoin\":\"round\"\n      }));\n      svg.appendChild(makeSvg(\"circle\", {\n        cx:px(currentT), cy:py(currentPsi[j]), r:6, fill:\"#fff\",\n        stroke:colors[j], \"stroke-width\":3\n      }));\n      svg.appendChild(makeSvg(\"text\", {\n        x:left+8, y:top+16+j*18, fill:colors[j], \"font-size\":13, \"font-weight\":\"700\"\n      }, \"성분 \" + (j + 1)));\n    });\n    svg.appendChild(makeSvg(\"text\", {\n      x:12, y:top+plotH/2, transform:\"rotate(-90 12 \" + (top+plotH/2) + \")\",\n      \"text-anchor\":\"middle\", fill:\"#17202a\", \"font-size\":12\n    }, \"좌표 성분\"));\n    graphWrap.hidden = false;\n  }\n\n  function calculate() {\n    try {\n      const x0 = parseVector(x0Input, \"x0\");\n      const x1 = parseVector(x1Input, \"x1\");\n      if (x0.length !== x1.length) throw new Error(\"x0과 x1 벡터의 차원이 같아야 합니다.\");\n      const t = parseScalar(tInput, \"t\");\n      const sigma = parseScalar(sigmaInput, \"sigma_min\");\n      if (t < 0 || t > 1) throw new Error(\"t는 [0, 1] 범위여야 합니다.\");\n      if (sigma <= 0) throw new Error(\"sigma_min은 0보다 커야 합니다.\");\n\n      const a = 1 - (1 - sigma) * t;\n      if (!(a > 0) || !Number.isFinite(a)) throw new Error(\"파생 변수 a가 유효한 양수가 아닙니다.\");\n      const psi = x0.map((value, i) => a * value + t * x1[i]);\n      const numerator = x0.map((value, i) => x1[i] - (1 - sigma) * value);\n      const fixed = numerator.map(value => value / a);\n      const moving = numerator;\n\n      outputs.a.textContent = formatNumber(a);\n      outputs.psi.textContent = formatVector(psi);\n      outputs.fixed.textContent = formatVector(fixed);\n      outputs.moving.textContent = formatVector(moving);\n      errorBox.hidden = true;\n      errorBox.textContent = \"\";\n      drawGraph(x0, x1, sigma, t, psi);\n    } catch (error) {\n      clearResults(error instanceof Error ? error.message : \"입력을 확인하세요.\");\n    }\n  }\n\n  function assertClose(actual, expected, label) {\n    if (Math.abs(actual - expected) > 1e-8) {\n      throw new Error(\"검산 실패: \" + label);\n    }\n  }\n\n  function verifyExample() {\n    const sigma = 0.1, t = 0.5;\n    const x0 = [1, -2], x1 = [3, 4];\n    const a = 1 - (1 - sigma) * t;\n    const psi = x0.map((v, i) => a * v + t * x1[i]);\n    const fixed = x0.map((v, i) => (x1[i] - (1 - sigma) * v) / a);\n    const moving = x0.map((v, i) => x1",
